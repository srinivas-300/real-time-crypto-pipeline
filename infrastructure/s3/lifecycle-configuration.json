{
  "Rules": [
    {
      "ID": "abort-incomplete-multipart-uploads",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
    },
    {
      "ID": "expire-error-records",
      "Status": "Enabled",
      "Filter": { "Prefix": "errors/crypto/" },
      "Expiration": { "Days": 30 }
    },
    {
      "ID": "expire-emr-logs",
      "Status": "Enabled",
      "Filter": { "Prefix": "emr-logs/" },
      "Expiration": { "Days": 14 }
    },
    {
      "ID": "expire-checkpoint-old-versions",
      "Status": "Enabled",
      "Filter": { "Prefix": "checkpoints/spark/" },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 3 }
    },
    {
      "ID": "transition-bronze-to-ia",
      "Status": "Enabled",
      "Filter": { "Prefix": "bronze/crypto/" },
      "Transitions": [{ "Days": 30, "StorageClass": "STANDARD_IA" }],
      "NoncurrentVersionExpiration": { "NoncurrentDays": 14 }
    },
    {
      "ID": "transition-silver-to-ia",
      "Status": "Enabled",
      "Filter": { "Prefix": "silver/crypto/" },
      "Transitions": [{ "Days": 60, "StorageClass": "STANDARD_IA" }],
      "NoncurrentVersionExpiration": { "NoncurrentDays": 14 }
    },
    {
      "ID": "transition-gold-to-ia",
      "Status": "Enabled",
      "Filter": { "Prefix": "gold/crypto_5min/" },
      "Transitions": [{ "Days": 60, "StorageClass": "STANDARD_IA" }],
      "NoncurrentVersionExpiration": { "NoncurrentDays": 14 }
    }
  ]
}
