{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CrawlerReadSilverGold",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::crypto-pipeline-388381628350/silver/crypto/*",
        "arn:aws:s3:::crypto-pipeline-388381628350/gold/crypto_5min/*"
      ]
    },
    {
      "Sid": "CrawlerListSilverGold",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::crypto-pipeline-388381628350",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["silver/crypto/*", "gold/crypto_5min/*"]
        }
      }
    }
  ]
}
