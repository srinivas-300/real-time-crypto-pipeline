# Copy this file to .env for local development.
# On EC2, these are provided via a systemd EnvironmentFile (Phase 6) — never commit real values.

# --- Environment ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- CoinGecko API ---
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_SYMBOLS=bitcoin,ethereum,solana,cardano,dogecoin
COINGECKO_POLL_INTERVAL_SECONDS=30

# --- AWS / MSK ---
AWS_REGION=us-east-1
# AWS_MSK_IAM auth resolves region via botocore's Session.get_config_variable('region'),
# which reads AWS_DEFAULT_REGION (not EC2 instance metadata) - must be set explicitly.
AWS_DEFAULT_REGION=us-east-1
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_RAW=crypto.raw
KAFKA_TOPIC_DLQ=crypto.dlq
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=AWS_MSK_IAM

# --- Producer behavior ---
PRODUCER_MAX_RETRIES=5
PRODUCER_RETRY_BACKOFF_SECONDS=2
